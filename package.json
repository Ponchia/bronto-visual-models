{
  "name": "@ponchia/visual-models",
  "version": "0.1.0-beta.6-dev.0",
  "description": "Persistent, editable visual artifacts with identified elements, guarded operations and optional React renderers.",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Zeno Trevisan",
    "url": "https://brontolotto.observer/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ponchia/bronto-visual-models.git"
  },
  "homepage": "https://ponchia.github.io/bronto-visual-models/",
  "bugs": {
    "url": "https://github.com/Ponchia/bronto-visual-models/issues"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "npm@11.13.0",
  "files": [
    "dist",
    "src",
    "bin",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs",
    "examples",
    "THIRD_PARTY_NOTICES.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js"
    },
    "./styles.css": "./dist/react/styles.css",
    "./package.json": "./package.json",
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    },
    "./base.css": "./dist/react/base.css"
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "bronto-visual-models": "./bin/bronto-visual-models.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-assets.mjs",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test": "node --experimental-strip-types --test --test-concurrency=1 test/*.test.ts test/upstream/*.test.ts && node --test scripts/tests/*.test.mjs",
    "test:pack": "node scripts/test-packed-consumer.mjs",
    "test:browser": "node scripts/test-browser.mjs",
    "check": "npm run format:check && npm run lint:docs && npm run build && npm test && npm run test:pack",
    "demo": "vite demo --host 127.0.0.1",
    "site:build": "vite build demo --base=/bronto-visual-models/ --outDir ../site-dist",
    "prepack": "npm run build",
    "site:build:packed": "node scripts/build-packed-demo.mjs",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint:docs": "node scripts/lint-docs.mjs && node scripts/check-doc-links.mjs && node scripts/check-distribution.mjs",
    "bench:store": "node --experimental-strip-types scripts/benchmark-store.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "benchmark:layout": "node scripts/benchmark-layout.mjs",
    "bench:exploration": "node --experimental-strip-types scripts/benchmark-exploration.mjs"
  },
  "dependencies": {
    "lib0": "0.2.119"
  },
  "peerDependencies": {
    "@ponchia/ui": "^0.16.3",
    "@xyflow/react": "^12.12.0",
    "d3-sankey": "^0.12.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vega": "^6.4.0",
    "vega-lite": "^6.4.3",
    "vega-tooltip": "^1.1.0",
    "vis-data": "^8.0.5",
    "vis-timeline": "^8.5.4",
    "elkjs": "^0.12.0",
    "vega-interpreter": "^2.3.2"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "@xyflow/react": {
      "optional": true
    },
    "vega": {
      "optional": true
    },
    "vega-lite": {
      "optional": true
    },
    "vis-timeline": {
      "optional": true
    },
    "vis-data": {
      "optional": true
    },
    "@ponchia/ui": {
      "optional": true
    },
    "vega-tooltip": {
      "optional": true
    },
    "d3-sankey": {
      "optional": true
    },
    "elkjs": {
      "optional": true
    },
    "vega-interpreter": {
      "optional": true
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.5.15",
    "@ponchia/ui": "0.17.0",
    "@types/d3-sankey": "0.12.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@xyflow/react": "12.12.0",
    "d3-sankey": "0.12.3",
    "markdownlint": "0.42.0",
    "playwright": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vega": "6.4.0",
    "vega-lite": "6.5.0",
    "vega-tooltip": "1.1.0",
    "vis-data": "8.0.5",
    "vis-timeline": "8.5.4",
    "vite": "8.3.4",
    "elkjs": "0.12.0",
    "@dagrejs/dagre": "3.1.1",
    "vega-interpreter": "2.3.2"
  },
  "overrides": {
    "micromark-extension-math": {
      "katex": "0.18.2"
    }
  }
}
